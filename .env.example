# PolicyNest secrets. Never commit or deploy this file.
# Paste your Anthropic API key below; the Copilot proxy (policynest_mvp/copilot_api) reads it.
ANTHROPIC_API_KEY=your-key-here
COPILOT_MODEL=claude-opus-5-5
COPILOT_EFFORT=low
# JWT authentication: set a unique 32+ character secret only in the server environment.
JWT_SECRET=your-long-random-jwt-secret-here
JWT_TTL_SECONDS=3600
# SQLite must be mounted on persistent storage in production; do not keep it in the deploy bundle.
POLICYNEST_DB_PATH=/data/policynest.sqlite3
# Optional TLS SMTP password recovery (otherwise use the trusted admin CLI).
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_URL=https://policynest.embarko.app/
RAG_SEMANTIC=1
STRUCTURED_LOGS=0
